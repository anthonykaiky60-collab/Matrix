(function () {
  'use strict';
  var Eco = window.Eco = window.Eco || {};
 
  function rng(a) { return function () { a |= 0; a = a + 0x6D2B79F5 | 0; var t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
  function G(x, y, cx, cy, sx, sy) { var dx = (x - cx) / sx, dy = (y - cy) / sy; return Math.exp(-(dx * dx + dy * dy)); }
  function sm(a, b, x) { var t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); }
  function clamp(x, a, b) { return Math.min(b, Math.max(a, x)); }
 
  /* contorno da cabeça: crânio elíptico em cima, mandíbula afunilando */
  function halfWidth(y) {
    if (y > 0.18) { var k = (y - 0.18) / 0.66; return k >= 1 ? 0 : 0.62 * Math.sqrt(1 - k * k); }
    var t = (0.18 - y) / 1.08; if (t >= 1) return 0;
    return 0.62 * Math.pow(1 - Math.pow(t, 2.3), 0.85);
  }
 
  /* relevo facial: base em casca + feições como gaussianas */
  function height(x, y) {
    var hw = halfWidth(y); if (hw < 0.002) return -1;
    var u = Math.min(1, Math.abs(x) / hw);
    var vy = y / 0.95;
    var z = 0.30 * Math.pow(1 - u * u, 0.55) * Math.pow(Math.max(0, 1 - vy * vy), 0.4) + 0.02;
    z += 0.055 * (G(x, y, -.27, .37, .20, .05) + G(x, y, .27, .37, .20, .05));      // arcada
    z -= 0.085 * (G(x, y, -.27, .27, .13, .075) + G(x, y, .27, .27, .13, .075));    // órbitas
    z += 0.06 * G(x, y, 0, .15, .05, .22);                                           // ponte do nariz
    z += 0.17 * G(x, y, 0, -.12, .075, .07);                                         // ponta do nariz
    z += 0.07 * (G(x, y, -.115, -.14, .05, .05) + G(x, y, .115, -.14, .05, .05));   // asas
    z -= 0.04 * G(x, y, 0, -.24, .12, .04);                                          // sob o nariz
    z += 0.06 * (G(x, y, -.42, .05, .14, .11) + G(x, y, .42, .05, .14, .11));       // maçãs do rosto
    z -= 0.035 * (G(x, y, -.4, -.3, .12, .14) + G(x, y, .4, -.3, .12, .14));        // bochechas
    z += 0.045 * G(x, y, 0, -.37, .15, .035);                                        // lábio superior
    z += 0.055 * G(x, y, 0, -.47, .14, .04);                                         // lábio inferior
    z -= 0.06 * G(x, y, 0, -.415, .17, .012);                                        // linha da boca
    z += 0.06 * G(x, y, 0, -.72, .17, .10);                                          // queixo
    z -= 0.035 * G(x, y, 0, -.55, .12, .03);
    z += 0.04 * G(x, y, 0, .6, .35, .18);                                            // testa
    return z;
  }
  function occl(x, y) {
    var a = 0.95 * (G(x, y, -.27, .27, .13, .08) + G(x, y, .27, .27, .13, .08)) + 0.7 * G(x, y, 0, -.415, .17, .015)
      + 0.5 * G(x, y, 0, -.24, .12, .04) + 0.25 * (G(x, y, -.4, -.3, .12, .14) + G(x, y, .4, -.3, .12, .14));
    return clamp(a, 0, 0.78);
  }
  /* "luz" recebida: chave (alto-esquerda), preenchimento e contorno */
  function tone(x, y) {
    var e = 0.012, z = height(x, y);
    function h(a, b) { var v = height(a, b); return v < -0.5 ? z : v; }
    var zx = (h(x + e, y) - h(x - e, y)) / (2 * e), zy = (h(x, y + e) - h(x, y - e)) / (2 * e);
    var inv = 1 / Math.sqrt(zx * zx + zy * zy + 1), nx = -zx * inv, ny = -zy * inv, nz = inv;
    var key = Math.max(0, nx * -0.50 + ny * 0.55 + nz * 0.67);
    var fill = Math.max(0, nx * 0.62 + ny * -0.15 + nz * 0.77) * 0.28;
    var rim = Math.pow(1 - nz, 2.0) * 0.45;
    return clamp((0.10 + 0.95 * key + fill + rim) * (1 - occl(x, y)), 0, 1);
  }
 
  var GX = 181, GY = 241, X0 = -0.65, X1 = 0.65, Y0 = -0.95, Y1 = 0.88;
  function buildGrid() {
    var H = new Float32Array(GX * GY), T = new Float32Array(GX * GY);
    for (var j = 0; j < GY; j++) {
      var y = Y0 + (Y1 - Y0) * j / (GY - 1);
      for (var i = 0; i < GX; i++) {
        var x = X0 + (X1 - X0) * i / (GX - 1);
        H[j * GX + i] = height(x, y); T[j * GX + i] = halfWidth(y) > 0.002 ? tone(x, y) : 0;
      }
    }
    return { H: H, T: T };
  }
  function samp(A, x, y) {
    var fx = clamp((x - X0) / (X1 - X0), 0, 1) * (GX - 1), fy = clamp((y - Y0) / (Y1 - Y0), 0, 1) * (GY - 1);
    var i = Math.min(GX - 2, fx | 0), j = Math.min(GY - 2, fy | 0), a = fx - i, b = fy - j;
    return (A[j * GX + i] * (1 - a) + A[j * GX + i + 1] * a) * (1 - b) + (A[(j + 1) * GX + i] * (1 - a) + A[(j + 1) * GX + i + 1] * a) * b;
  }
 
  /* Layout por partícula (16 floats):
     a0: x y z tone | a1: mouthUpper, mouthLower|interior-w, jaw, corner
     a2: brow, kind(0 pele,1 olho E,2 olho D,3 interior boca), lid, side
     a3: seed, size, edge, iris                                         */
  Eco.buildFace = function (N, seed) {
    var rnd = rng(seed || 7), grid = buildGrid();
    var F = new Float32Array(Math.ceil(N * 1.2) * 16), c = 0;
    function put(x, y, z, t, mU, mL, jaw, cor, brow, kind, lid, side, edge, iris, size) {
      var o = c * 16;
      F[o] = x; F[o + 1] = y; F[o + 2] = z; F[o + 3] = t;
      F[o + 4] = mU; F[o + 5] = mL; F[o + 6] = jaw; F[o + 7] = cor;
      F[o + 8] = brow; F[o + 9] = kind; F[o + 10] = lid; F[o + 11] = side;
      F[o + 12] = rnd(); F[o + 13] = size || (0.0036 + 0.0042 * rnd() + (rnd() < 0.035 ? 0.0045 : 0)); F[o + 14] = edge; F[o + 15] = iris;
      c++;
    }
    var nSkin = (N * 0.80) | 0, tries = 0, got = 0;
    while (got < nSkin && tries < nSkin * 60) {
      tries++;
      var x = rnd() * 1.28 - 0.64, y = rnd() * 1.78 - 0.92, hw = halfWidth(y), ax = Math.abs(x);
      if (ax >= hw) continue;
      var t = samp(grid.T, x, y);
      if (rnd() > 0.05 + 0.95 * Math.pow(t, 1.4)) continue;
      var z = samp(grid.H, x, y), xf = 1 - sm(0.12, 0.26, ax);
      var mU = xf * sm(-0.425, -0.37, y) * (1 - sm(-0.33, -0.25, y));
      var mL = xf * sm(-0.40, -0.46, y) * (1 - sm(-0.55, -0.62, y));
      var jaw = sm(-0.405, -0.47, y) * (1 - sm(0.40, 0.62, ax));
      var cor = G(ax, y, 0.17, -0.415, 0.07, 0.06);
      var brow = clamp(G(x, y, -.27, .38, .2, .07) + G(x, y, .27, .38, .2, .07), 0, 1);
      var lid = clamp(G(x, y, -.27, .31, .12, .05) + G(x, y, .27, .31, .12, .05), 0, 1);
      var edge = 1 - sm(0, 0.11, hw - ax);
      put(x, y, z, t * (0.85 + 0.3 * rnd()), mU, mL, jaw, cor, brow, 0, lid, x < 0 ? -1 : 1, edge, 0);
      got++;
    }
    /* globos oculares: iris brilhante, pupila escura (vazio), esclera cinza */
    var nEye = (N * 0.025) | 0;
    [-1, 1].forEach(function (side) {
      for (var i = 0; i < nEye; i++) {
        var th = Math.acos(1 - rnd() * 0.85), ph = rnd() * 6.2832, r = 0.075;
        if (th < 0.17 && rnd() > 0.06) continue;                       // pupila
        var iris = th < 0.46 ? 1 : 0, ring = th > 0.38 && th < 0.46;
        var tt = iris ? (ring ? 1.0 : 0.78 + 0.2 * rnd()) : 0.45 + 0.2 * rnd();
        put(side * 0.27 + r * Math.sin(th) * Math.cos(ph), 0.27 + r * Math.sin(th) * Math.sin(ph), 0.235 + r * Math.cos(th),
          tt, 0, 0, 0, 0, 0, side < 0 ? 1 : 2, 0, side, 0, iris, 0.0034 + 0.003 * rnd());
      }
    });
    /* interior da boca (dentes/língua) — só aparece com a boca aberta */
    var nMouth = (N * 0.03) | 0;
    for (var m = 0; m < nMouth; m++) {
      var w = rnd(), mx = (rnd() * 2 - 1) * 0.125 * (1 - 0.35 * w);
      put(mx, -0.415, height(0, -0.415) - 0.06, w < 0.22 ? 0.95 : 0.35 + 0.3 * rnd(), w, 0, 0, 0, 0, 3, 0, 0, 0, 0, 0.0034 + 0.003 * rnd());
    }
    /* pescoço que se dissolve */
    var nNeck = (N * 0.05) | 0;
    for (var k = 0; k < nNeck; k++) {
      var d = Math.pow(rnd(), 1.4), ny = -0.86 - d * 0.5, nx = (rnd() * 2 - 1) * (0.2 - d * 0.06);
      put(nx, ny, 0.02 - d * 0.1 + 0.05 * rnd(), 0.22 + 0.25 * rnd() * (1 - d), 0, 0, 1, 0, 0, 0, 0, nx < 0 ? -1 : 1, 1, 0);
    }
    /* poeira desprendida ao redor do contorno (fragmentação) */
    var nHalo = (N * 0.07) | 0, hh = 0, ht = 0;
    while (hh < nHalo && ht < nHalo * 30) {
      ht++;
      var hx = (rnd() * 2 - 1) * 0.95, hy = rnd() * 1.9 - 0.95, hw2 = halfWidth(hy);
      var out = Math.abs(hx) - hw2; if (out < 0.0 || out > 0.3) continue;
      if (rnd() > Math.exp(-out * 9)) continue;
      put(hx, hy, (rnd() - 0.5) * 0.3, 0.18 + 0.3 * rnd(), 0, 0, hy < -0.4 ? 1 : 0, 0, 0, 0, 0, hx < 0 ? -1 : 1, 1.3, 0);
      hh++;
    }
    /* embaralha: desenhar os primeiros k% = subamostragem uniforme (LOD) */
    var tmp = new Float32Array(16);
    for (var i2 = c - 1; i2 > 0; i2--) {
      var j2 = (rnd() * (i2 + 1)) | 0; if (j2 === i2) continue;
      var a = i2 * 16, b = j2 * 16;
      for (var q = 0; q < 16; q++) { tmp[q] = F[a + q]; F[a + q] = F[b + q]; F[b + q] = tmp[q]; }
    }
    return { data: F.subarray(0, c * 16), count: c };
  };
 
  /* =====================================================================
     PERSONA — decide como o rosto se comporta em cada estado
     (parado, ouvindo, pensando, falando, final) e em cada "tom" emocional.
     Tudo é suavizado com decaimento exponencial, então nada "estala".
     ===================================================================== */
  var EXPR = {
    neutro:      { browL: 0,   browR: 0,   furrow: 0,    smileL: 0,    smileR: 0,    squint: 0,    widen: 0,   roll: 0,    pitch: 0 },
    curioso:     { browL: .45, browR: .8,  furrow: 0,    smileL: .05,  smileR: .12,  squint: 0,    widen: .3,  roll: .12,  pitch: -.02 },
    intrigado:   { browL: .9,  browR: .05, furrow: .25,  smileL: 0,    smileR: .28,  squint: .1,   widen: 0,   roll: -.09, pitch: 0 },
    serio:       { browL: -.15, browR: -.15, furrow: .7, smileL: 0,    smileR: 0,    squint: .28,  widen: 0,   roll: 0,    pitch: .05 },
    sorrindo:    { browL: .2,  browR: .2,  furrow: 0,    smileL: .55,  smileR: .55,  squint: .18,  widen: 0,   roll: .04,  pitch: -.02 },
    ameacador:   { browL: -.1, browR: -.1, furrow: .55,  smileL: .1,   smileR: .4,   squint: .38,  widen: 0,   roll: 0,    pitch: .13 },
    melancolico: { browL: .45, browR: .45, furrow: .35,  smileL: -.4,  smileR: -.4,  squint: .12,  widen: 0,   roll: -.05, pitch: .1 }
  };
  Eco.TONES = Object.keys(EXPR);
 
  function Persona() {
    this.tone = 'neutro'; this.state = 'idle';
    this.cur = Object.assign({}, EXPR.neutro);
    this.gaze = [0, 0]; this.gazeT = [0, 0]; this.nextSacc = 0;
    this.nextBlink = 2; this.blinkT0 = -9; this.blink = 0;
    this.yaw = 0; this.pitch = 0; this.roll = 0; this.z = 0;
    this.bright = 0.7; this.tint = [1, 1, 1]; this.think = 0.1; this.mouth = { open: 0, wide: 0, round: 0 };
    this.energy = 0;
  }
  Persona.prototype.setTone = function (t) { if (EXPR[t]) this.tone = t; };
  Persona.prototype.setState = function (s) { this.state = s; this.nextSacc = 0; };
 
  Persona.prototype.update = function (dt, t, d) {
    var s = this.state, k = function (r) { return 1 - Math.exp(-r * dt); }, r = Math.random, cur = this.cur;
    /* expressão-alvo = tom atual + viés do estado */
    var tgt = Object.assign({}, EXPR[this.tone] || EXPR.neutro);
    if (s === 'listening') { tgt.browL += .15; tgt.browR += .15; tgt.widen += .1; tgt.roll += .05; }
    if (s === 'thinking') { tgt.furrow += .25; tgt.squint += .12; tgt.browL += .1; }
    if (s === 'finale') { tgt.furrow += .4; tgt.squint += .3; tgt.smileR += .4; }
    for (var key in tgt) cur[key] += (tgt[key] - cur[key]) * k(4.5);
 
    /* boca: vem da sincronia labial; se não fala, fecha suavemente */
    var m = d.mouth || { open: 0, wide: 0, round: 0 }, mk = k(34);
    this.mouth.open += (m.open - this.mouth.open) * mk;
    this.mouth.wide += (m.wide - this.mouth.wide) * mk;
    this.mouth.round += (m.round - this.mouth.round) * mk;
    this.energy += (this.mouth.open - this.energy) * k(6);
 
    /* cabeça: deriva lenta + comportamento do estado */
    var yaw = Math.sin(t * .31) * .07 + Math.sin(t * .13 + 1) * .04, pit = Math.sin(t * .23) * .03 + cur.pitch,
      rol = Math.sin(t * .17) * .02 + cur.roll, zz = 0;
    if (s === 'listening') { yaw *= .5; zz = .14; rol += .05 * Math.sin(t * .6); pit += .035 * Math.sin(t * 4.6) * (d.micLevel || 0); }
    else if (s === 'thinking') { yaw = -.14 + Math.sin(t * .5) * .05; pit -= .05; rol -= .04; }
    else if (s === 'speaking') { yaw += Math.sin(t * 1.7) * .03 * this.energy; pit += (this.mouth.open - .35) * -.05; zz = .04; }
    else if (s === 'finale') { zz = .3 + Math.min(1, d.finale || 0) * .5; yaw *= .3; }
    var kh = k(3.2);
    this.yaw += (yaw - this.yaw) * kh; this.pitch += (pit - this.pitch) * kh; this.roll += (rol - this.roll) * kh; this.z += (zz - this.z) * kh;
 
    /* olhos: sacadas (movimentos rápidos) com alvos que dependem do estado */
    if (t > this.nextSacc) {
      var g = this.gazeT;
      if (s === 'thinking') { g[0] = -.5 + r() * .3; g[1] = .45 + r() * .2; this.nextSacc = t + .8 + r() * 1.4; }
      else if (s === 'listening') { g[0] = (r() - .5) * .18; g[1] = (r() - .5) * .12; this.nextSacc = t + .5 + r() * 1.8; }
      else if (s === 'speaking') { var look = r() < .55; g[0] = look ? 0 : (r() - .5) * .5; g[1] = look ? 0 : (r() - .5) * .25; this.nextSacc = t + .7 + r() * 2; }
      else { g[0] = (r() - .5) * .9; g[1] = (r() - .5) * .5; this.nextSacc = t + 1 + r() * 2.5; }
    }
    var kg = k(16); this.gaze[0] += (this.gazeT[0] - this.gaze[0]) * kg; this.gaze[1] += (this.gazeT[1] - this.gaze[1]) * kg;
 
    /* piscadas */
    if (t > this.nextBlink) { this.blinkT0 = t; this.nextBlink = t + 1.8 + r() * 4.2; }
    var bt = t - this.blinkT0; this.blink = bt < .16 ? 1 - Math.abs(bt / .08 - 1) : 0;
 
    /* luz: brilho, matiz e "agitação" reagem ao estado */
    var br = .75, tint = [1, 1, 1], th = .1, lv = d.micLevel || 0;
    if (s === 'listening') { br = .95 + .25 * lv; tint = [.92, .98, 1]; th = .05; }
    else if (s === 'thinking') { br = .7 + .15 * Math.sin(t * 4); tint = [.72, 1, .84]; th = 1; }
    else if (s === 'speaking') { br = 1 + .35 * this.mouth.open; tint = [1, 1, 1]; th = .1; }
    else if (s === 'finale') { br = 1.15; tint = [.55, 1, .7]; th = .6; }
    var kl = k(3);
    this.bright += (br - this.bright) * kl; this.think += (th - this.think) * kl;
    for (var i = 0; i < 3; i++) this.tint[i] += (tint[i] - this.tint[i]) * kl;
  };
 
  Eco.Persona = Persona;
})();
 
