    },
    translate: function (x, y, z) { var m = M4.ident(); m[12] = x; m[13] = y; m[14] = z; return m; },
    scale: function (s) { var m = M4.ident(); m[0] = m[5] = m[10] = s; return m; },
    rotX: function (a) { var c = Math.cos(a), s = Math.sin(a), m = M4.ident(); m[5] = c; m[6] = s; m[9] = -s; m[10] = c; return m; },
    rotY: function (a) { var c = Math.cos(a), s = Math.sin(a), m = M4.ident(); m[0] = c; m[2] = -s; m[8] = s; m[10] = c; return m; },
    rotZ: function (a) { var c = Math.cos(a), s = Math.sin(a), m = M4.ident(); m[0] = c; m[1] = s; m[4] = -s; m[5] = c; return m; },
    /* Perspectiva "off-axis" (frustum assimétrico) — é o método correto para
       estereoscopia: a câmera de cada olho é deslocada em X e o frustum é
       deslocado no sentido contrário para que o plano de convergência (conv)
       fique exatamente sobre a tela, sem rotacionar as câmeras (rotacionar
       geraria paralaxe vertical e cansaço visual). */
